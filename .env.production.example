# Copy the needed settings into .env privately. Keep existing credentials and data on upgrades.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_COMMAND_SCOPE=global
AUTO_DEPLOY_COMMANDS=true

# Use a real DNS name pointing at your host; no scheme, port or path in DASHBOARD_DOMAIN.
DASHBOARD_DOMAIN=bot.your-domain.example
DASHBOARD_ENABLED=true
DASHBOARD_URL=https://bot.your-domain.example
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3000
# The production Compose stack sets this and hides the backend port.
DASHBOARD_TRUST_PROXY=true
DATA_DIR=./data
LOG_LEVEL=info
POLL_INTERVAL_SECONDS=60

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
TIKTOK_EULER_API_KEY=
# Official TikTok Login Kit + video.list; production requires TikTok app approval.
# Register DASHBOARD_URL/auth/tiktok/callback. Keep these values server-only.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional YouTube Data API v3 key; live discovery is quota-limited.
YOUTUBE_API_KEY=

# Optional independent TLS listener; no change to the primary dashboard by default.
# Needs a browser-trusted certificate, direct inbound allocation and an additional
# Discord OAuth redirect. The Compose example does not publish this port for you.
# See FALLBACK_HOSTING.md. A second listener does not survive a full host outage.
DASHBOARD_FALLBACK_ENABLED=false
DASHBOARD_FALLBACK_URL=
DASHBOARD_FALLBACK_HOST=0.0.0.0
DASHBOARD_FALLBACK_PORT=
DASHBOARD_FALLBACK_CERT_FILE=
DASHBOARD_FALLBACK_KEY_FILE=
# Prism launcher only; leave unset on ordinary native/Compose hosting.
# CYRO_INTERNAL_DASHBOARD_PORT=3000
