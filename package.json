{
  "name": "cyro",
  "version": "2.13.0",
  "private": true,
  "description": "Self-hosted multi-server Discord community bot with a dashboard, stream alerts, moderation, tickets and games.",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "preview": "tsx src/dashboard/preview.ts",
    "start": "node dist/src/index.js",
    "deploy-commands": "node dist/src/deploy-commands.js",
    "check-hosting": "node dist/src/check-hosting.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@napi-rs/canvas": "1.0.11",
    "discord.js": "14.27.0",
    "dotenv": "16.6.1",
    "ffmpeg-static": "5.3.0",
    "opusscript": "0.1.1",
    "proper-lockfile": "4.1.2",
    "text2wav": "0.0.14",
    "tiktok-live-connector": "2.4.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/proper-lockfile": "4.1.4",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "license": "MIT"
}
