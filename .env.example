# One bot application serves all guilds. Never share this file after adding secrets.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Global commands work in every server that installs the bot.
DISCORD_COMMAND_SCOPE=global
# Optional testing only: set scope to development and provide a test server ID.
DISCORD_DEV_GUILD_ID=
AUTO_DEPLOY_COMMANDS=true

# Enable Server Members + Message Content intents in the Developer Portal.
# Set Public Bot ON and Guild Install ON for public invitations.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
TIKTOK_EULER_API_KEY=
# Official TikTok Login Kit + Display API; use sandbox credentials for target-user testing.
# Register https://your-domain/auth/tiktok/callback in TikTok (separate from Discord).
# Request only user.info.basic and video.list. Tokens remain private in DATA_DIR.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional YouTube: enable YouTube Data API v3, restrict this server-only key to that API.
# Live discovery defaults to 15 minutes per distinct YouTube channel to share search quota.
YOUTUBE_API_KEY=
POLL_INTERVAL_SECONDS=60
DATA_DIR=./data
LOG_LEVEL=info

DASHBOARD_ENABLED=true
DISCORD_CLIENT_SECRET=
# Register DASHBOARD_URL/auth/callback under OAuth2 Redirects in Discord.
# A public dashboard must use HTTPS. Local development can use localhost HTTP.
DASHBOARD_URL=http://localhost:3000
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
# Enable only behind a single trusted reverse proxy that appends X-Forwarded-For.
# Keep the origin port inaccessible to public clients when this is enabled.
DASHBOARD_TRUST_PROXY=false
# Hosting platforms may supply PORT instead of DASHBOARD_PORT.
